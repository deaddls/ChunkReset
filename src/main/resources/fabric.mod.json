	"authors": [
		"ChunkReset contributors"
	],
	"contact": {},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.chunkreset.ChunkReset"
		]
	},
	"mixins": [
		"chunkreset.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
